---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Mulled Container Builder" } = Astro.props;
const base = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Browse bioconda and conda-forge packages, assemble a multi-package container, and open a pull request to build it."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-6 py-4">
        <a href={base} class="flex items-center gap-2 font-semibold">
          <span class="text-2xl">🫙</span>
          <span>Mulled Container Builder</span>
        </a>
        <span class="ml-auto text-sm text-slate-500">
          <a
            href="https://github.com/BioContainers/multi-package-containers"
            class="hover:text-slate-900">GitHub repo</a
          >
        </span>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-6 text-sm text-slate-500">
        Built containers are published to{" "}
        <a
          href="https://quay.io/organization/biocontainers"
          class="text-slate-700 underline">quay.io/biocontainers</a
        >
        {" "}(Docker) and{" "}
        <a
          href="https://depot.galaxyproject.org/singularity/"
          class="text-slate-700 underline">depot.galaxyproject.org/singularity</a
        >
        {" "}(Singularity, mirrored via CVMFS). Powered by{" "}
        <a
          href="https://github.com/galaxyproject/galaxy/tree/dev/lib/galaxy/tool_util/deps/mulled"
          class="text-slate-700 underline">mulled</a>.
      </div>
    </footer>
  </body>
</html>
